{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OnyxMessageEvent",
  "type": "object",
  "required": ["event", "payload"],
  "properties": {
    "event": {
      "type": "string",
      "enum": ["messageCreated", "messageDelivered", "messageRead", "messageEdited", "messageDeleted"]
    },
    "payload": {
      "type": "object",
      "required": ["id", "chat_id", "sender_id", "client_message_id", "status"],
      "properties": {
        "id": { "type": "string" },
        "chat_id": { "type": "string" },
        "sender_id": { "type": "string" },
        "client_message_id": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] }
      }
    }
  }
}
